{
  "name": "markdown-table-gui",
  "displayName": "Markdown Table GUI",
  "description": "Edit Markdown tables in an Excel-like GUI inside Visual Studio Code.",
  "version": "1.0.0",
  "publisher": "RyutaC2",
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "icon": "markdown_table_gui.png",
  "homepage": "https://github.com/RyutaC2/md-table-editor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RyutaC2/md-table-editor.git"
  },
  "bugs": {
    "url": "https://github.com/RyutaC2/md-table-editor/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "table",
    "grid",
    "excel",
    "editor"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdown-table-gui.editTable",
    "onCommand:markdown-table-gui.quickInsertTable",
    "onCommand:markdown-table-gui.insertTable",
    "onWebviewPanel:markdown-table-gui.tableEditor"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/browser/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "markdown-table-gui.editTable",
        "title": "%command.editTable%",
        "category": "%extension.category%"
      },
      {
        "command": "markdown-table-gui.quickInsertTable",
        "title": "%command.quickInsertTable%",
        "category": "%extension.category%"
      },
      {
        "command": "markdown-table-gui.insertTable",
        "title": "%command.insertTable%",
        "category": "%extension.category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdown-table-gui.editTable",
          "when": "false"
        },
        {
          "command": "markdown-table-gui.quickInsertTable",
          "when": "false"
        },
        {
          "command": "markdown-table-gui.insertTable",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "markdown-table-gui.editTable",
          "when": "editorLangId == markdown && mdTableEditor.inTable",
          "group": "1_modification@90"
        },
        {
          "command": "markdown-table-gui.quickInsertTable",
          "when": "editorLangId == markdown",
          "group": "1_modification@100"
        },
        {
          "command": "markdown-table-gui.insertTable",
          "when": "editorLangId == markdown",
          "group": "1_modification@101"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run check:notices && node esbuild.js --production",
    "package:vsix": "node scripts/package-vsix.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "tsc -p tsconfig.unit.json && mocha --ui tdd \"out-unit/test/core/**/*.test.js\"",
    "benchmark": "tsc -p tsconfig.unit.json && node scripts/benchmark.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "check:notices": "node scripts/generate-third-party-notices.mjs --check",
    "test": "vscode-test",
    "test:web": "npm run compile && vscode-test-web --extensionDevelopmentPath=. --extensionTestsPath=dist/web-test/index.js --browser=chromium --quality=stable --headless --verbose --printServerLog"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
